{
  "name": "@poweron/telegram-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/schedule.test.cjs test/pwa.test.cjs",
    "prestart": "npm run build",
    "start": "nodemon --config nodemon.json dist/index.js",
    "dev": "nodemon --watch src --watch tsconfig.json --ext ts,json --exec \"npm run build && node dist/index.js\""
  },
  "dependencies": {
    "@poweron/shared": "*",
    "better-auth": "^1.7.28",
    "cheerio": "^1.2.0",
    "pg": "^8.23.1",
    "telegraf": "^4.16.3",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "nodemon": "^3.1.11",
    "typescript": "~5.9.3"
  }
}
