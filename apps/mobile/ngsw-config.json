{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/manifest.webmanifest", "/icons/*.png", "/*.css", "/*.js"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "schedule",
      "urls": ["/api/schedule$"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 1, "maxAge": "1d", "timeout": "3s" }
    }
  ]
}
